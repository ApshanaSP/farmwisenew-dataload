# Copy to .env and fill in only what you need. The pipeline runs fully with this
# file absent: Google News RSS + publisher feeds need no keys.

# ---- Optional news APIs (connector is enabled only when its key is set) ----
NEWSAPI_KEY=
GNEWS_API_KEY=

# ---- Optional LLM classification (department + complaint flag) ----
# When set, gpt-4o-mini classifies each processed article (same provider as the
# dashboard's ai-classifier.ts). Without it, the offline keyword model is used.
OPENAI_API_KEY=

# ---- Optional MySQL output (enabled when DB_HOST, DB_USER and DB_NAME are set) ----
# Same variable names as the dashboard's .env, so you can reuse its database.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=district_collector_dashboard
